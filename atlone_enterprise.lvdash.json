{
  "datasets": [
    {
      "name": "df8a4b36",
      "displayName": "general",
      "queryLines": [
        "SELECT\n",
        "  f.date,\n",
        "  date_trunc('month', f.date) AS month,\n",
        "  p.category,\n",
        "  c.channel,\n",
        "  f.product_code,\n",
        "  c.customer,\n",
        "  p.product,\n",
        "  p.variant,\n",
        "  f.customer_code,\n",
        "  f.sold_quantity,\n",
        "  pr.price_inr,\n",
        "  (f.sold_quantity * pr.price_inr) AS revenue\n",
        "FROM\n",
        "  atlone_enterprise.gold.4_fact_orders f\n",
        "    LEFT JOIN atlone_enterprise.gold.2_dim_products p\n",
        "      ON f.product_code = p.product_code\n",
        "    LEFT JOIN atlone_enterprise.gold.1_dim_customers c\n",
        "      ON f.customer_code = c.customer_code\n",
        "    LEFT JOIN atlone_enterprise.gold.3_dim_gross_price pr\n",
        "      ON f.product_code = pr.product_code"
      ]
    },
    {
      "name": "31d5b92c",
      "displayName": "parent",
      "queryLines": [
        "SELECT\r\n",
        "    f.date, p.category, c.channel, f.product_code, \r\n",
        "    f.sold_quantity, pr.price_inr, \r\n",
        "    (f.sold_quantity * pr.price_inr) AS revenue\r\n",
        "FROM atlone_enterprise.gold.parent_fact_orders f\r\n",
        "LEFT JOIN atlone_enterprise.gold.parent_dim_products p ON f.product_code = p.product_code\r\n",
        "LEFT JOIN atlone_enterprise.gold.parent_dim_customers c ON f.customer_code = c.customer_code\r\n",
        "LEFT JOIN atlone_enterprise.gold.parent_dim_gross_price pr ON f.product_code = pr.product_code"
      ]
    },
    {
      "name": "ae0c9ce6",
      "displayName": "child",
      "queryLines": [
        "SELECT\r\n",
        "    f.date, p.category, c.channel, f.product_code, \r\n",
        "    f.sold_quantity, pr.gross_price, \r\n",
        "    (f.sold_quantity * pr.gross_price) AS revenue\r\n",
        "FROM atlone_enterprise.gold.child_fact_orders f\r\n",
        "LEFT JOIN atlone_enterprise.gold.child_dim_products p ON f.product_code = p.product_code\r\n",
        "LEFT JOIN atlone_enterprise.gold.child_dim_customers c ON f.customer_code = c.customer_id\r\n",
        "LEFT JOIN atlone_enterprise.gold.child_dim_gross_price pr ON f.product_code = pr.product_code"
      ]
    }
  ],
